{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fireline.nasa-space-app.org/schemas/finding.schema.json",
  "title": "Finding",
  "description": "Canonical schema for scientific findings and illustrative evidence synthesis records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "investigation_id",
    "related_test_run_ids",
    "title",
    "finding_text",
    "summary",
    "research_category",
    "module_tags",
    "evidence_type",
    "confidence_label",
    "limitations",
    "source_references",
    "data_status",
    "is_mock"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^FND-[A-Z0-9-]+$"
    },
    "investigation_id": {
      "type": "string",
      "pattern": "^INV-[A-Z0-9-]+$"
    },
    "related_test_run_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^TR-[A-Z0-9-]+$"
      }
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "finding_text": {
      "type": "string",
      "minLength": 20
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "research_category": {
      "type": "string",
      "minLength": 2
    },
    "module_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["FIRELINE", "TESTMATCH", "SMOKEWISE"]
      }
    },
    "evidence_type": {
      "type": "string",
      "enum": ["observed", "calculated", "interpretation", "research_implication"]
    },
    "confidence_label": {
      "type": "string",
      "enum": ["high", "moderate", "preliminary", "illustrative_synthetic"]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "source_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^SRC-[A-Z0-9-]+$"
      }
    },
    "data_status": {
      "type": "string",
      "enum": [
        "reported",
        "approximate",
        "range",
        "not_reported",
        "not_applicable",
        "synthetic_demo",
        "needs_review",
        "unparsed"
      ]
    },
    "is_mock": {
      "type": "boolean"
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fireline.nasa-space-app.org/schemas/test_run.schema.json",
  "title": "TestRun",
  "description": "Canonical schema for an experimental test run across microgravity combustion investigations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "investigation_id",
    "test_label",
    "test_sequence",
    "gravity_regime",
    "fuel_name",
    "fuel_family",
    "geometry",
    "sample_dimensions",
    "experimental_conditions",
    "outcome_categories",
    "measurement_ids",
    "source_ids",
    "data_status",
    "is_mock"
  ],
  "definitions": {
    "dimensionValue": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["value", "unit", "normalized_m"],
      "properties": {
        "value": { "type": ["number", "null"] },
        "unit": { "type": "string" },
        "normalized_m": { "type": ["number", "null"] }
      }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TR-[A-Z0-9-]+$"
    },
    "investigation_id": {
      "type": "string",
      "pattern": "^INV-[A-Z0-9-]+$"
    },
    "test_label": {
      "type": "string",
      "minLength": 2
    },
    "test_sequence": {
      "type": ["integer", "null"]
    },
    "gravity_regime": {
      "type": "string",
      "enum": [
        "microgravity",
        "lunar_partial",
        "martian_partial",
        "earth_normal",
        "parabolic_low_g"
      ]
    },
    "fuel_name": {
      "type": "string",
      "minLength": 1
    },
    "fuel_family": {
      "type": "string",
      "minLength": 1
    },
    "geometry": {
      "type": "string",
      "enum": [
        "flat_sheet",
        "thin_fabric",
        "cylindrical_rod",
        "spherical_droplet",
        "wire_insulation",
        "heated_lamp_filament",
        "structured_array"
      ]
    },
    "sample_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "length": { "$ref": "#/definitions/dimensionValue" },
        "width": { "$ref": "#/definitions/dimensionValue" },
        "thickness": { "$ref": "#/definitions/dimensionValue" },
        "diameter": { "$ref": "#/definitions/dimensionValue" },
        "notes": { "type": ["string", "null"] }
      }
    },
    "experimental_conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oxygen_pct_vol",
        "pressure_kpa",
        "airflow_cm_s",
        "ambient_temp_k",
        "flow_direction",
        "ignition_method"
      ],
      "properties": {
        "oxygen_pct_vol": { "type": ["number", "null"] },
        "pressure_kpa": { "type": ["number", "null"] },
        "airflow_cm_s": { "type": ["number", "null"] },
        "ambient_temp_k": { "type": ["number", "null"] },
        "flow_direction": {
          "type": "string",
          "enum": ["concurrent", "opposed", "quiescent", "coaxial_jet", "mixed"]
        },
        "ignition_method": { "type": "string" }
      }
    },
    "outcome_categories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "measurement_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^MEAS-[A-Z0-9-]+$"
      }
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^SRC-[A-Z0-9-]+$"
      }
    },
    "data_status": {
      "type": "string",
      "enum": [
        "reported",
        "approximate",
        "range",
        "not_reported",
        "not_applicable",
        "synthetic_demo",
        "needs_review",
        "unparsed"
      ]
    },
    "is_mock": {
      "type": "boolean"
    }
  }
}

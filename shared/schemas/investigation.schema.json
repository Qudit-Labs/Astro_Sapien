{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fireline.nasa-space-app.org/schemas/investigation.schema.json",
  "title": "Investigation",
  "description": "Canonical schema for a NASA Physical Sciences Informatics (PSI) microgravity combustion investigation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "short_name",
    "psi_id",
    "doi",
    "description",
    "research_objectives",
    "research_categories",
    "module_tags",
    "fire_safety_pillar",
    "gravity_regimes",
    "fuel_types",
    "source_ids",
    "official_url",
    "data_availability",
    "is_mock_metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^INV-[A-Z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "short_name": {
      "type": "string",
      "minLength": 2
    },
    "psi_id": {
      "type": "string",
      "pattern": "^PSI-[0-9]+$"
    },
    "doi": {
      "type": ["string", "null"]
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "research_objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "research_categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "module_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["FIRELINE", "TESTMATCH", "SMOKEWISE"]
      }
    },
    "fire_safety_pillar": {
      "type": "string",
      "enum": ["prevention", "detection", "suppression", "supporting"]
    },
    "gravity_regimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "microgravity",
          "lunar_partial",
          "martian_partial",
          "earth_normal",
          "parabolic_low_g"
        ]
      }
    },
    "fuel_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^SRC-[A-Z0-9-]+$"
      }
    },
    "official_url": {
      "type": "string",
      "format": "uri"
    },
    "data_availability": {
      "type": "string",
      "enum": [
        "public_metadata_only",
        "partial_open_data",
        "full_psi_dataset",
        "synthetic_preview"
      ]
    },
    "is_mock_metadata": {
      "type": "boolean"
    }
  }
}

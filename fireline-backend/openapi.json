          "pillar": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pillar"
          }
        },
        "type": "object",
        "title": "FirelineAnalyzeRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ReportRequest": {
        "properties": {
          "topic": {
            "type": "string",
            "title": "Topic",
            "default": "Spacecraft Fire Prevention, Detection, and Suppression Synthesis"
          },
          "experiment_a": {
            "type": "string",
            "title": "Experiment A",
            "default": "PSI-25:B1"
          },
          "experiment_b": {
            "type": "string",
            "title": "Experiment B",
            "default": "PSI-98:S1"
          }
        },
        "type": "object",
        "title": "ReportRequest"
      },
      "SmokewiseRequest": {
        "properties": {
          "material": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Material"
          },
          "include_spice": {
            "type": "boolean",
            "title": "Include Spice",
            "default": true
          }
        },
        "type": "object",
        "title": "SmokewiseRequest"
      },
      "TestMatchRequest": {
        "properties": {
          "experiment_a": {
            "type": "string",
            "title": "Experiment A",
            "example": "PSI-25:B1"
          },
          "experiment_b": {
            "type": "string",
            "title": "Experiment B",
            "example": "PSI-98:S1"
          }
        },
        "type": "object",
        "required": [
          "experiment_a",
          "experiment_b"
        ],
        "title": "TestMatchRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
